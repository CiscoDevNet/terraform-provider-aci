func TestNestedReadAndPayload(t *testing.T) {
	ctx := context.Background()
	object, err := container.ParseJSON([]byte(`{"imdata":[{"fvTenant":{"attributes":{"dn":"uni/tn-fixture","name":"fixture"},"children":[{"fvAp":{"attributes":{"name":"application"},"children":[{"fvAEPg":{"attributes":{"name":"one","fwdCtrl":"proxy-arp"},"children":[{"fvRsDomAtt":{"attributes":{"tDn":"uni/phys-one-a"},"children":[{"tagAnnotation":{"attributes":{"key":"key_1","value":"one-a-key_1"}}},{"tagAnnotation":{"attributes":{"key":"key_2","value":"one-a-key_2"}}}]}}]}},{"fvAEPg":{"attributes":{"name":"two","fwdCtrl":"proxy-arp"}}}]}}]}}]}`))
	if err != nil {
		t.Fatal(err)
	}
	model := models.NewFvTenantRootModelNull()
	{{ if .RetainAlias -}}
	fallback := model.FvTenantModel
	{{ end -}}
	found, diagnostics := model.SetFromResponse(ctx, object)
	if diagnostics.HasError() || !found {
		t.Fatalf("decode: found=%t; diagnostics=%v", found, diagnostics)
	}
	{{ if .RetainAlias -}}
	diagnostics.Append(model.SetLegacyFromResponse(ctx, object, &fallback)...)
	if diagnostics.HasError() {
		t.Fatal(diagnostics)
	}
	value := model.FvAp.Attributes()[epgAttribute].(types.Set)
	var members []models.FvAEPgModel
	diagnostics.Append(value.ElementsAs(ctx, &members, false)...)
	if diagnostics.HasError() || len(members) != 2 {
		t.Fatalf("members: %v; diagnostics: %v", members, diagnostics)
	}
	for _, member := range members {
		if !member.LegacyOldName.Equal(member.Name) {
			t.Fatalf("legacy name %s does not match decoded name %s", member.LegacyOldName, member.Name)
		}
		for _, value := range member.FvRsDomAtt.Elements() {
			attributes := value.(types.Object).Attributes()
			if !attributes["old_target_dn"].Equal(attributes["target_dn"]) {
				t.Fatal("domain alias does not match its decoded target")
			}
			for _, annotation := range attributes["annotations"].(types.Set).Elements() {
				values := annotation.(types.Object).Attributes()
				if !values["old_key"].Equal(values["key"]) || !values["old_value"].Equal(values["value"]) {
					t.Fatal("annotation aliases do not match their decoded owner")
				}
			}
		}
	}
	{{ end -}}
	payload, payloadDiagnostics := model.BuildPayload(ctx, nil, true, false, "")
	if payloadDiagnostics.HasError() {
		t.Fatal(payloadDiagnostics)
	}
	var body any
	if err := json.Unmarshal([]byte(payload.String()), &body); err != nil {
		t.Fatal(err)
	}
	var check func(any)
	check = func(value any) {
		switch value := value.(type) {
		case map[string]any:
			for _, name := range []string{"old_name", "old_policy_name", "old_target_dn", "old_key", "old_value", "old_frozen"} {
				if _, exists := value[name]; exists {
					t.Fatalf("legacy Terraform attribute %s leaked into the APIC payload", name)
				}
			}
			for _, member := range value {
				check(member)
			}
		case []any:
			for _, member := range value {
				check(member)
			}
		}
	}
	check(body)
}

