func TestNestedFrameworkPlanning(t *testing.T) {
	ctx := context.Background()
	server := providerserver.NewProtocol6(New("nested-fixture")())()
	schema := models.FvTenantResourceSchema("")
	state, err := tftypes.ValueFromJSON(fixtureJSON(t, fixtureState(false, true, false)), schema.Type().TerraformType(ctx))
	if err != nil {
		t.Fatal(err)
	}
	prior, err := tfprotov6.NewDynamicValue(state.Type(), state)
	if err != nil {
		t.Fatal(err)
	}
	for _, mode := range []string{"legacy", "current", "mixed"} {
		legacy := mode != "current"
		config := fixtureState(legacy, legacy, false)
		delete(config, "id")
		members := config[applicationAttribute].(map[string]any)[epgAttribute].([]any)
		members[0], members[1] = members[1], members[0]
		if mode == "mixed" {
			member := members[0].(map[string]any)
			member["name"] = member["old_name"]
			delete(member, "old_name")
		}
		for _, member := range members {
			delete(member.(map[string]any), "description")
			delete(member.(map[string]any), "forwarding_control")
		}
		configured, err := tftypes.ValueFromJSON(fixtureJSON(t, config), state.Type())
		if err != nil {
			t.Fatal(err)
		}
		dynamic, err := tfprotov6.NewDynamicValue(state.Type(), configured)
		if err != nil {
			t.Fatal(err)
		}
		validation, err := server.ValidateResourceConfig(ctx, &tfprotov6.ValidateResourceConfigRequest{TypeName: "aci_tenant", Config: &dynamic})
		if err != nil {
			t.Fatal(err)
		}
		fixtureDiagnostics(t, validation.Diagnostics)
		response, err := server.PlanResourceChange(ctx, &tfprotov6.PlanResourceChangeRequest{
			TypeName: "aci_tenant", Config: &dynamic, PriorState: &prior, ProposedNewState: &prior,
		})
		if err != nil {
			t.Fatal(err)
		}
		fixtureDiagnostics(t, response.Diagnostics)
		actual, err := response.PlannedState.Unmarshal(state.Type())
		if err != nil {
			t.Fatal(err)
		}
		if !actual.Equal(state) || len(response.RequiresReplace) > 0 {
			t.Fatalf("legacy=%t: expected unchanged state without replacement; plan: %s; replacement: %v", legacy, actual, response.RequiresReplace)
		}
	}
}

func TestNestedFrozenPlanning(t *testing.T) {
	ctx := context.Background()
	server := providerserver.NewProtocol6(New("nested-fixture")())()
	schema := models.FvTenantResourceSchema("")
	previous := fixtureState(false, true, false)
	for _, marker := range []string{"kept", ""} {
		config := fixtureState(false, false, false)
		expected := fixtureState(false, true, false)
		delete(config, "id")
		configured := config[applicationAttribute].(map[string]any)[epgAttribute].([]any)
		wanted := expected[applicationAttribute].(map[string]any)[epgAttribute].([]any)
		for index := range configured {
			configured[index].(map[string]any)["old_frozen"] = marker
			wanted[index].(map[string]any)["old_frozen"] = marker
		}
		var values []tftypes.Value
		for _, object := range []map[string]any{previous, config, expected} {
			value, err := tftypes.ValueFromJSON(fixtureJSON(t, object), schema.Type().TerraformType(ctx))
			if err != nil {
				t.Fatal(err)
			}
			values = append(values, value)
		}
		prior, err := tfprotov6.NewDynamicValue(values[0].Type(), values[0])
		if err != nil {
			t.Fatal(err)
		}
		dynamic, err := tfprotov6.NewDynamicValue(values[1].Type(), values[1])
		if err != nil {
			t.Fatal(err)
		}
		response, err := server.PlanResourceChange(ctx, &tfprotov6.PlanResourceChangeRequest{TypeName: "aci_tenant", Config: &dynamic, PriorState: &prior, ProposedNewState: &prior})
		if err != nil {
			t.Fatal(err)
		}
		fixtureDiagnostics(t, response.Diagnostics)
		actual, err := response.PlannedState.Unmarshal(values[2].Type())
		if err != nil || !actual.Equal(values[2]) || len(response.RequiresReplace) != 0 {
			t.Fatalf("frozen %q: plan=%v; expected=%v; error=%v", marker, actual, values[2], err)
		}
		previous = expected
	}
}
