func fixtureState(legacy, retained, duplicates bool) map[string]any {
	// These handwritten values exercise two distinct members and an independently specified list-to-set result.
	var members []any
	for _, name := range []string{"one", "two"} {
		flags := []string{"proxy-arp"}
		if duplicates {
			flags = append(flags, "proxy-arp")
		}
		member := map[string]any{"description": "description-" + name, "forwarding_control": flags}
		if legacy || retained {
			member["old_name"] = name
		}
		if !legacy {
			member["name"] = name
		}
		members = append(members, member)
	}
	state := map[string]any{
		"id": "uni/tn-fixture", "annotation": "",
		applicationAttribute: map[string]any{"name": "application", epgAttribute: members},
	}
	if legacy || retained {
		state["old_name"] = "fixture"
	}
	if !legacy {
		state["name"] = "fixture"
	}
	return state
}

func fixtureJSON(t *testing.T, value any) []byte {
	t.Helper()
	contents, err := json.Marshal(value)
	if err != nil {
		t.Fatal(err)
	}
	return contents
}

func fixtureDiagnostics(t *testing.T, diagnostics []*tfprotov6.Diagnostic) {
	t.Helper()
	for _, diagnostic := range diagnostics {
		if diagnostic.Severity == tfprotov6.DiagnosticSeverityError {
			t.Fatalf("%s: %s", diagnostic.Summary, diagnostic.Detail)
		}
	}
}

func TestNestedRegisteredStateUpgraders(t *testing.T) {
	ctx := context.Background()
	server := providerserver.NewProtocol6(New("nested-fixture")())()
	for _, name := range []string{"aci_tenant", "aci_bridge_domain"} {
		for index, version := range map[string][]int64{"aci_tenant": {1, 3}, "aci_bridge_domain": {4, 7}}[name] {
			current := models.FvTenantResourceSchema("")
			if name == "aci_bridge_domain" {
				current = models.FvBDResourceSchema("")
			}
			response, err := server.UpgradeResourceState(ctx, &tfprotov6.UpgradeResourceStateRequest{
				TypeName: name, Version: version,
				RawState: &tfprotov6.RawState{JSON: fixtureJSON(t, fixtureState(index == 0, true, index == 0))},
			})
			if err != nil {
				t.Fatal(err)
			}
			fixtureDiagnostics(t, response.Diagnostics)
			actual, err := response.UpgradedState.Unmarshal(current.Type().TerraformType(ctx))
			if err != nil {
				t.Fatal(err)
			}
			expected, err := tftypes.ValueFromJSON(fixtureJSON(t, fixtureState(false, {{ .RetainAlias }}, false)), current.Type().TerraformType(ctx))
			if err != nil {
				t.Fatal(err)
			}
			if !actual.Equal(expected) {
				t.Fatalf("%s version %d:\nactual: %s\nexpected: %s", name, version, actual, expected)
			}
		}
	}
}

func TestNestedUnchangedPropertyLifecycle(t *testing.T) {
	// The field has no replacement alias: historical versions decode it, and current removal discards it.
	{{ if not .RetainAlias -}}
	ctx := context.Background()
	server := providerserver.NewProtocol6(New("nested-fixture")())()
	{{ end -}}
	testCases := []test.TestCase{
		{Name: "aci_tenant", Input: []int64{1, 3}},
		{Name: "aci_bridge_domain", Input: []int64{4, 7}},
	}
	for _, testCase := range testCases {
		t.Run(testCase.Name, func(t *testing.T) {
			current := models.FvTenantResourceSchema("")
			datasource := models.FvTenantDataSourceSchema()
			if testCase.Name == "aci_bridge_domain" {
				current = models.FvBDResourceSchema("")
				datasource = models.FvBDDataSourceSchema()
			}
			{{ if .RetainAlias -}}
			for _, message := range []string{current.Attributes["description"].GetDeprecationMessage(), datasource.Attributes["description"].GetDeprecationMessage()} {
				if message == "" {
					t.Fatal("unchanged description field lost its explicit provider deprecation")
				}
			}
			{{ else -}}
			if _, exists := current.Attributes["description"]; exists {
				t.Fatal("removed description still exists in the current resource schema")
			}
			if _, exists := datasource.Attributes["description"]; exists {
				t.Fatal("removed description still exists in the current datasource schema")
			}
			for index, version := range testCase.Input.([]int64) {
				prior := fixtureState(index == 0, true, index == 0)
				prior["description"] = "removed-root-description"
				response, err := server.UpgradeResourceState(ctx, &tfprotov6.UpgradeResourceStateRequest{
					TypeName: testCase.Name, Version: version,
					RawState: &tfprotov6.RawState{JSON: fixtureJSON(t, prior)},
				})
				if err != nil {
					t.Fatal(err)
				}
				fixtureDiagnostics(t, response.Diagnostics)
				actual, err := response.UpgradedState.Unmarshal(current.Type().TerraformType(ctx))
				if err != nil {
					t.Fatal(err)
				}
				expected, err := tftypes.ValueFromJSON(fixtureJSON(t, fixtureState(false, false, false)), current.Type().TerraformType(ctx))
				if err != nil {
					t.Fatal(err)
				}
				if !actual.Equal(expected) {
					t.Fatalf("version %d did not discard only the removed field and mapped aliases:\nactual: %s\nexpected: %s", version, actual, expected)
				}
			}
			{{ end -}}
		})
	}
}

