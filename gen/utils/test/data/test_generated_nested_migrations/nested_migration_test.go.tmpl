func TestNestedGeneratedAcceptanceChecks(t *testing.T) {
	checks := []resource.TestCheckFunc{
{{ range .AcceptanceChecks }}
		{{ . }},
{{ end }}
	}
	// This state is specified independently from the generator's test configuration and assertion builders.
	attributes := map[string]string{}
	for epgIndex, name := range []string{"one", "two"} {
		epgPath := fmt.Sprintf("%s.%s.%d", applicationAttribute, epgAttribute, epgIndex)
		attributes[epgPath+".name"] = name
		attributes[epgPath+".old_name"] = name
		attributes[epgPath+"."+domainAttribute+".#"] = "2"
		for domainIndex, domain := range []string{"a", "b"} {
			domainPath := fmt.Sprintf("%s.%s.%d", epgPath, domainAttribute, domainIndex)
			attributes[domainPath+".target_dn"] = "uni/phys-"+name+"-"+domain
			attributes[domainPath+".old_target_dn"] = attributes[domainPath+".target_dn"]
			attributes[domainPath+".annotations.#"] = "2"
			for annotationIndex, key := range []string{"key_1", "key_2"} {
				path := domainPath+".annotations."+strconv.Itoa(annotationIndex)
				attributes[path+".key"], attributes[path+".old_key"] = key, key
				attributes[path+".value"], attributes[path+".old_value"] = name+"-"+domain+"-"+key, name+"-"+domain+"-"+key
			}
		}
	}
	state := &terraform.State{Modules: []*terraform.ModuleState{ {Path: []string{"root"}, Resources: map[string]*terraform.ResourceState{
		"aci_tenant.test_1": {Type: "aci_tenant", Primary: &terraform.InstanceState{ID: "uni/tn-fixture", Attributes: attributes}},
		"data.aci_tenant.test": {Type: "aci_tenant", Primary: &terraform.InstanceState{ID: "uni/tn-fixture", Attributes: attributes}},
	}}}}
	for index, check := range checks {
		if err := check(state); err != nil {
			t.Fatalf("generated check %d: %v", index, err)
		}
	}
	path := applicationAttribute+"."+epgAttribute+".0."+domainAttribute+".0.annotations."
	attributes[path+"0.old_value"], attributes[path+"1.old_value"] = attributes[path+"1.old_value"], attributes[path+"0.old_value"]
	detected := false
	for _, check := range checks {
		detected = check(state) != nil || detected
	}
	if !detected {
		t.Fatal("generated assertions accepted legacy values on the wrong set members")
	}
}
